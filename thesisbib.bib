@article{cosmological_constant_upper_limit,
  author={Shuang Liang and Yi Xie},
  title={New upper limit on the cosmological constant from solar system dynamics},
  journal={Research in Astronomy and Astrophysics},
  volume={14},
  number={5},
  pages={527},
  url={http://stacks.iop.org/1674-4527/14/i=5/a=003},
  year={2014},
  abstract={The cosmological constant Î is the simplest model for explaining the dark energy which supposedly drives the observed accelerated expansion rate of the Universe. Together with the concept of cold dark matter, it satisfactorily accommodates a wealth of observations related to cosmology. Due to its assumed constancy throughout the Universe, Î might also affect the dynamics of the planets in the solar system, although with extremely small effects. However, modern high-precision ephemerides provide a promising tool for constraining it. Using the supplementary advances in the perihelia provided by current INPOP10a and EPM2011 ephemerides, we obtain a new upper limit on Î in the solar system when the Lense-Thirring effect due to the Sun's angular momentum and the uncertainty of the Sun's quadrupole moment are properly taken into account. These two factors were mostly absent in previous works dealing with Î. We find that INPOP10a yields an upper limit of Î = (0.26 Â± 1.45) Ã 10 â43 m â2 and EPM2011 gives Î = (â0.44 Â± 8.93) Ã 10 â43 m â2 . Such bounds are about 10 times less than previously estimated results.}
}

